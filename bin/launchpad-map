#!/bin/zsh
# DESC: Inspect the macOS Launchpad layout — dump to JSON, render as HTML, or apply a new arrangement
set -euo pipefail

REPO="${0:A:h:h}"
LIB="$REPO/lib"

usage() {
  cat <<'EOF'
launchpad-map — inspect and visualise the macOS Launchpad layout

USAGE
  launchpad-map dump   [--out FILE] [--title TEXT] [--date YYYY-MM-DD] [--db PATH] [--save]
  launchpad-map history [--out FILE] [--open] [--device mac|phone|tablet]
  launchpad-map showcase [--out FILE] [--open]
  launchpad-map render --out FILE [--layout FILE]... [--page-size N] [--icon-px N]
  launchpad-map open   [--layout FILE]...
  launchpad-map write  LAYOUT [--dry-run] [--no-restart] [--backup-dir DIR]
  launchpad-map inventory INVENTORY.md [--out FILE] [--label TEXT] [--no-icons]
  launchpad-map phone dump [--save] [--out FILE] [--serial SERIAL] [--note TEXT] [--pages-only]
  launchpad-map phone history [--out FILE] [--open]
  launchpad-map phone write PROPOSAL [--dry-run] [--from SNAPSHOT] [--max-ops N]
  launchpad-map phone usage [--json] [--save] [--serial SERIAL]
  launchpad-map phone reorg REORG.json [--title T] [--note N] > layouts/phone/proposal-N.json
  launchpad-map phone op   peek | go PAGE | read FOLDER | split FOLDER --to PAGE APP... |
                           group PAGE NAME APP... | into FOLDER APP... | to-page PAGE APP... |
                           move-folder FOLDER --to PAGE | reorder FOLDER APP... | lock on|off |
                           pause | resume | stop
  launchpad-map phone watch [--port N] [--open]
  launchpad-map phone status                  # one JSON line: attached, awake, locked, ready
  launchpad-map tablet dump|history|write|usage|reorg|op|watch|status ...
  launchpad-map --help

COMMANDS
  dump     Read the live Launchpad database and print a layout JSON document.
           The format is hand-editable: apps are named by their Launchpad
           title, folders are {"folder": "Name", "apps": [...]}.

  render   Turn one or more layout JSON files into a single self-contained
           HTML page that looks like Launchpad. Icons are embedded as data
           URIs, so the file works offline. Pass --layout more than once,
           oldest first, for a history view that marks what moved, what is
           new and what was uninstalled between snapshots. With no --layout,
           the live database is rendered.

  open     Render to a temporary file and open it in the default browser.

  history  Render every device's snapshots — the Mac's Launchpad, the phone,
           the tablet — to one page, history.html in the repo, with a switcher
           between them; oldest first and drafts last. `dump --save` adds a
           snapshot by hand; `write` adds one for each layout it applies.

  showcase Render the newest snapshot with only the apps showcase.json
           approves, to showcase.html in the repo. Apps it does not list are
           hidden until reviewed; the history view counts them.

  write    Apply a layout to the live Launchpad database. Backs the database
           up first, applies everything in one transaction, then restarts the
           Dock. Adds a snapshot to the history. Use
           --dry-run to see the report without writing.

  phone    The Android phone's home screen, read over adb (HyperOS launcher).
           `phone dump` walks every page and folder, reading labels from the
           UI hierarchy and cropping icons from screenshots; --save adds it
           to layouts/phone/. `phone history` is `history`, opening on the
           phone with --open. The only input sent to the phone is HOME, BACK,
           page swipes and taps on folder icons.

  tablet   The same commands for the Android tablet, kept apart in
           layouts/tablet/. With the phone and the tablet both attached, each
           command picks its own device.

  inventory
           Cross-reference a saved app inventory (Mac App Store / Homebrew
           casks / /Applications, as dumped during a machine offboarding)
           against this machine, and write a self-contained HTML report with
           real app icons. Read-only.

EXAMPLES
  launchpad-map dump --out layouts/current.json
  launchpad-map render --layout layouts/current.json \
                       --layout layouts/proposed.json --out /tmp/lp.html
  launchpad-map open
  launchpad-map write layouts/proposed.json --dry-run

NOTES
  Every command except `write` is read-only.
EOF
}

case "${1-}" in
  dump)   shift; exec python3 "$LIB/dump.py" "$@" ;;
  render) shift; exec python3 "$LIB/render.py" "$@" ;;
  write)  shift; exec python3 "$LIB/write.py" "$@" ;;
  history) shift; exec python3 "$LIB/history.py" "$@" ;;
  inventory) shift; exec python3 "$LIB/inventory.py" "$@" ;;
  showcase) exec python3 "$LIB/history.py" "$@" ;;
  phone|tablet)
    export LAUNCHPAD_MAP_DEVICE="$1"
    shift
    case "${1-}" in
      dump)    shift; exec python3 "$LIB/phone.py" "$@" ;;
      history) shift; exec python3 "$LIB/history.py" --device "$LAUNCHPAD_MAP_DEVICE" "$@" ;;
      write)   shift; exec python3 "$LIB/phone_write.py" "$@" ;;
      usage)   shift; exec python3 "$LIB/phone_usage.py" "$@" ;;
      reorg)   shift; exec python3 "$LIB/phone_reorg.py" "$@" ;;
      op)      shift; exec python3 "$LIB/phone_op.py" "$@" ;;
      watch)   shift; exec python3 "$LIB/phone_watch.py" "$@" ;;
      status)  shift; exec python3 "$LIB/phone_status.py" "$@" ;;
      *) print -u2 "launchpad-map: $LAUNCHPAD_MAP_DEVICE takes dump, history, write, usage, reorg, op, watch or status"; exit 64 ;;
    esac
    ;;
  open)
    shift
    out="$(mktemp -t launchpad-map.XXXXXX).html"
    python3 "$LIB/render.py" --out "$out" "$@"
    exec open "$out"
    ;;
  -h|--help|help|"") usage ;;
  *) print -u2 "launchpad-map: unknown command '${1}'"; usage; exit 64 ;;
esac
