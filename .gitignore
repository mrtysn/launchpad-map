*.html
.DS_Store
__pycache__/
*.pyc

# Dumped layouts are an inventory of the apps installed on one machine.
# layouts/example.json is the committed sample; real dumps stay local.
layouts/*.json
!layouts/example.json
layouts/phone/
layouts/tablet/

# Showcase approvals list this machine's apps too; showcase.example.json is the sample.
showcase.json
lib/.window-id
